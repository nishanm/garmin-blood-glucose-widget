<?xml version="1.0" encoding="utf-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="850dc349860d4d79b2fefdb6345a118e"
                    type="widget"
                    name="@Strings.AppName"
                    entry="BGWidgetApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.2.0">
        <!-- Trimmed to the hardware-tested pair. The UI is touch-first (the
             60m/3h/6h chart frames change by horizontal SWIPE) and leans on
             color to signal glucose range, so it was only verified on watches
             that support both. venu441mm is the developed/tested device;
             venu445mm is its identical sibling (same rendering + touch input,
             larger screen).

             To add another watch: re-add its <iq:product> id AND sim-check
             glance + full view first. Button-only devices (fenix8, epix2,
             marq2, fenix7, instinct3) can't reach the swipe frames, and MIP
             screens (fr255/955, fenix7, enduro3) mute the color bands. See
             docs/DEVICES.md before re-adding either family. -->
        <iq:products>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
