# Copy to .env and fill in (gitignored — never commit the real file).
# .env changes need `docker compose up -d --build` (a recreate), not a
# stop/start — uvicorn reads the environment once at process start.
WATCH_TOKEN=generate-with-python-secrets-token-urlsafe-32
NIGHTSCOUT_URL=https://your-nightscout-site.example.com
NIGHTSCOUT_TOKEN=your-nightscout-readable-token
